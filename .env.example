# Copy this file to ".env" and fill in your Supabase anon (publishable) key.
# Vite only exposes vars prefixed with VITE_ to the browser.

# Project ref: tazqkbcgbomajbtbthde
VITE_SUPABASE_URL=https://tazqkbcgbomajbtbthde.supabase.co

# Find this in Supabase Dashboard -> Project Settings -> API -> "anon public" key
# (or the newer "Publishable key", format sb_publishable_...). It is safe to ship
# to the browser as long as Row Level Security is enabled (see supabase/schema.sql).
VITE_SUPABASE_ANON_KEY=your-anon-key-here
